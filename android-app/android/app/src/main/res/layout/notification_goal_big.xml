<?xml version="1.0" encoding="utf-8"?>
<!-- the goal notification: an animation (IslandArt.drawGoalAnimated frames in a flipper), like the island's goal card -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="150dp">

    <ViewFlipper
        android:id="@+id/goal_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="140" />

    <ImageView
        android:id="@+id/goal_picture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/goal_channel"
        android:scaleType="fitCenter"
        android:visibility="gone" />
</FrameLayout>
