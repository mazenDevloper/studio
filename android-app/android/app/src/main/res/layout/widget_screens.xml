<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/screen_dashboard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/widget_btn" android:gravity="center" android:text="🏠\nالرئيسية" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/screen_matches" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/widget_btn" android:gravity="center" android:text="⚽\nالمباريات" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/screen_iptv" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/widget_btn" android:gravity="center" android:text="📺\nIPTV" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/screen_media" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/widget_btn" android:gravity="center" android:text="🎬\nالوسائط" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/screen_quran" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/widget_btn" android:gravity="center" android:text="📖\nالقرآن" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/screen_azkar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/widget_btn" android:gravity="center" android:text="📿\nالأذكار" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/screen_settings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/widget_btn" android:gravity="center" android:text="⚙\nالإعدادات" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
