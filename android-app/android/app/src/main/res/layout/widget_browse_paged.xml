<?xml version="1.0" encoding="utf-8"?>
<!-- the reciters / subscriptions widget: no header; on the right (before the avatars) a column the avatars' height:
     next 40% · previous 40% · search 20% -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <GridView
            android:id="@+id/folders_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnWidth="88dp"
            android:horizontalSpacing="6dp"
            android:layoutDirection="rtl"
            android:numColumns="auto_fit"
            android:stretchMode="columnWidth"
            android:verticalSpacing="6dp" />

        <TextView
            android:id="@+id/folders_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/browse_prev"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="4"
            android:background="@drawable/widget_btn_round"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/browse_next"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="4"
            android:background="@drawable/widget_btn_round"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/browse_search_round"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:background="@drawable/widget_btn_round"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="🔍"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
