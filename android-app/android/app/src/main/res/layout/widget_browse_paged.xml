<?xml version="1.0" encoding="utf-8"?>
<!-- the reciters / subscriptions widget: one row of avatars, no header; search and ‹ › fixed at the bottom left -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <GridView
        android:id="@+id/folders_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:columnWidth="88dp"
        android:horizontalSpacing="6dp"
        android:layoutDirection="rtl"
        android:numColumns="auto_fit"
        android:stretchMode="columnWidth"
        android:verticalSpacing="6dp" />

    <TextView
        android:id="@+id/folders_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#80FFFFFF"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/browse_search_round"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_round"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="🔍"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/browse_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_round"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/browse_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_btn_round"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
